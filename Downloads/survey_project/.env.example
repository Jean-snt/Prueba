# ============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO PARA CUESTOM
# ============================================================================
# Copia este archivo como .env y completa con tus datos reales

# ============================================================================
# CONFIGURACIÓN GENERAL
# ============================================================================
# ENVIRONMENT: development, staging, production
ENVIRONMENT=development

# DEBUG: True solo en desarrollo, False en producción
DEBUG=True

# DJANGO_SECRET_KEY: Clave secreta de Django (generar nueva para producción)
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION

# ALLOWED_HOSTS: Hosts permitidos separados por comas (solo en producción)
# Ejemplo: ALLOWED_HOSTS=cuestom.com,www.cuestom.com,api.cuestom.com
ALLOWED_HOSTS=

# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (OPCIÓN 1: DATABASE_URL - RECOMENDADO)
# ============================================================================
# DATABASE_URL es la forma recomendada de configurar la base de datos
# Especialmente útil para AWS RDS, Heroku, y otros servicios cloud
#
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# Ejemplo desarrollo (local):
# DATABASE_URL=postgresql://postgres:tu-password@localhost:5432/cuestom_db
#
# Ejemplo producción (AWS RDS):
# DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@database-1.c41o6yqueege.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
#
DATABASE_URL=

# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (OPCIÓN 2: Variables individuales)
# ============================================================================
# Si no usas DATABASE_URL, configura estas variables individuales:

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cuestom_db
DB_USER=postgres
DB_PASSWORD=tu-password-de-postgres

# ============================================================================
# INSTRUCCIONES PARA AWS RDS POSTGRESQL:
# ============================================================================
# 1. Crea una instancia RDS PostgreSQL en AWS Console
# 2. Obtén el endpoint (ejemplo: database-1.xxxxx.us-east-1.rds.amazonaws.com)
# 3. Configura DATABASE_URL con tus credenciales:
#    DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_ENDPOINT:5432/postgres?sslmode=require
# 4. Asegúrate de que el Security Group de RDS permita conexiones desde tu IP
# 5. En producción, habilita SSL/TLS: ?sslmode=require
#
# IMPORTANTE:
# - NUNCA subas el archivo .env a Git (ya está en .gitignore)
# - Usa AWS Secrets Manager para almacenar DATABASE_URL en producción
# - Habilita backups automáticos y Multi-AZ para alta disponibilidad
#
# ============================================================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# ============================================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion

# Email por defecto para envíos del sistema
DEFAULT_FROM_EMAIL=tu-email@gmail.com

# ============================================================================
# INSTRUCCIONES PARA GMAIL:
# ============================================================================
# 1. Ve a tu cuenta de Google: https://myaccount.google.com/
# 2. Seguridad > Verificación en 2 pasos (debe estar activada)
# 3. Seguridad > Contraseñas de aplicaciones
# 4. Genera una nueva contraseña de aplicación para "Cuestom"
# 5. Usa esa contraseña (16 caracteres) en EMAIL_HOST_PASSWORD
# 
# ⚠️  NUNCA uses tu contraseña personal de Gmail
# ⚠️  En producción, considera usar AWS SES en lugar de Gmail
#
# ============================================================================
# OTROS PROVEEDORES SMTP:
# ============================================================================
# 
# Outlook/Hotmail:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
#
# Yahoo:
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587
#
# AWS SES (Recomendado para producción):
# EMAIL_BACKEND=django_ses.SESBackend
# AWS_SES_REGION_NAME=us-east-1
# AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com
#
# ============================================================================
# CONFIGURACIÓN DE PAYPAL
# ============================================================================

PAYPAL_CLIENT_ID=tu-paypal-client-id-sandbox
PAYPAL_CLIENT_SECRET=tu-paypal-client-secret-sandbox
PAYPAL_MODE=sandbox

# ============================================================================
# INSTRUCCIONES PARA PAYPAL:
# ============================================================================
# 1. Ve a https://developer.paypal.com/
# 2. Crea una aplicación en el Dashboard
# 3. Obtén Client ID y Client Secret del Sandbox
# 4. Para producción, cambia PAYPAL_MODE=live y usa credenciales de producción
#
# ============================================================================
# CONFIGURACIÓN DE URLS (SOLO PRODUCCIÓN)
# ============================================================================
# URLs del frontend y backend para CORS y CSRF

# URL del frontend React (ejemplo: https://cuestom.com)
FRONTEND_URL=

# URL del backend Django (ejemplo: https://api.cuestom.com)
BACKEND_URL=

# ============================================================================
# CONFIGURACIÓN DE AWS (OPCIONAL - PARA S3, SES, etc.)
# ============================================================================

# AWS Credentials (si no usas IAM Roles)
# AWS_ACCESS_KEY_ID=tu-access-key
# AWS_SECRET_ACCESS_KEY=tu-secret-key
# AWS_REGION=us-east-1

# S3 para archivos media (opcional)
# AWS_STORAGE_BUCKET_NAME=cuestom-media
# AWS_S3_CUSTOM_DOMAIN=cuestom-media.s3.amazonaws.com

# ============================================================================