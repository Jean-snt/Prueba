# ============================================================================
# VARIABLES DE ENTORNO - FRONTEND REACT
# ============================================================================
# Copia este archivo como .env y configura según el entorno

# ============================================================================
# DESARROLLO LOCAL
# ============================================================================
REACT_APP_API_URL=http://localhost:8000/encuestas/api
REACT_APP_DJANGO_URL=http://localhost:8000

# ============================================================================
# PRODUCCIÓN (AWS)
# ============================================================================
# Descomentar y configurar para producción:

# URL de la API del backend (AWS App Runner / ALB)
# REACT_APP_API_URL=https://api.cuestom.com/encuestas/api

# URL base de Django (mismo que API_URL sin /encuestas/api)
# REACT_APP_DJANGO_URL=https://api.cuestom.com

# ============================================================================
# STAGING
# ============================================================================
# Para entorno de pruebas:

# REACT_APP_API_URL=https://staging-api.cuestom.com/encuestas/api
# REACT_APP_DJANGO_URL=https://staging-api.cuestom.com

# ============================================================================
# NOTAS IMPORTANTES:
# ============================================================================
# 1. Las variables DEBEN comenzar con REACT_APP_ para que Create React App
#    las incluya en el build
#
# 2. Después de cambiar .env, debes reiniciar el servidor de desarrollo:
#    npm start
#
# 3. Para build de producción, asegúrate de tener las variables correctas:
#    npm run build
#
# 4. NUNCA incluyas .env en Git (ya está en .gitignore)
#
# 5. Para AWS App Runner/CloudFront, la URL debe ser HTTPS
#
# ============================================================================
