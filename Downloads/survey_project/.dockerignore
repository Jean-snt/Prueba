# ============================================================================
# DOCKERIGNORE - Archivos a excluir del contexto de Docker
# ============================================================================

# Variables de entorno (se pasan como ENV en runtime)
.env
.env.*
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environment
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Base de datos local
*.sqlite3
db.sqlite3
*.db

# Git
.git/
.gitignore
.gitattributes

# Node.js (frontend)
frontend/node_modules/
frontend/build/
frontend/.env
node_modules/
npm-debug.log

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation
*.md
!README.md
docs/

# Respaldos y temporales
backup*/
*.backup
*.bak
*.tmp
data_backup_total.json

# Scripts de desarrollo
scripts/
cleanup_project.ps1
iniciar_sistema_completo.bat

# Media files (se suben a S3 en producción)
media/
staticfiles/

# Kubernetes y otros configs de cloud
*.yaml
!apprunner.yaml
*.yml
!docker-compose.yml
terraform/
.terraform/

# Archivos de análisis generados
ANALISIS_TECNICO_Y_AWS.md
RESUMEN_EJECUTIVO.md
INSTRUCCIONES_LIMPIEZA.md
